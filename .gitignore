# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build

# Ignore local properties (sensitive SDK locations)
local.properties

# Ignore large bootstrap assets and packaging roots
bootstrap.tar
bootstrap_root/
# Pinned Debian rootfs shipped in APK assets (local/CI place under assets/rootfs/)
app/src/main/assets/rootfs/*.tar.xz
debian_13_rootfs.tar.xz
termux-packages/*
!termux-packages/output/
!termux-packages/output/**

# Ignore IDE, agent, and memory logs
.claude/
.serena/
.agents/
.tokensave/
*.hprof
*.png
